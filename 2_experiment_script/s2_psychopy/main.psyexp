        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="$&quot;Sie haben nun die Übungsdurchgänge beendet.&quot; + &quot;\n\n&quot; + &quot;In der nachfolgenden Test-Phase werden Sie 4 Blöcke mit jeweils ca. 100 Durchgängen bearbeiten. Zwischen den einzelnen Test-Blöcken haben Sie jeweils Zeit für eine Pause.&quot; + &quot;\n\n&quot; + group_instruction1" valType="str" updates="set every repeat" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
