        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="$'Legen Sie nun bitte Ihre beiden Zeigefinger auf den Tasten &quot;A&quot; und &quot;L&quot; ab.' + &quot;\n\n&quot; + 'Es folgen nun ein paar Übungsdurchgänge.\nEs ist wichtig, dass Sie Ihre beiden Zeigefinger währen aller Durchgänge auf diesen Tasten liegen lassen.' + &quot;\n\n&quot; + 'Zur Erinnerung: Drücken Sie die Taste &quot;A&quot; für &quot;' +  condition[0] + '&quot; (d. h., die Fläche ' + adjective[0] + ' Flecken ist insgesamt größer) und die Taste &quot;L&quot; für &quot;' + condition[1] + '&quot; (d. h., die Fläche ' + adjective[1] + ' Flecken ist insgesamt größer).'" valType="str" updates="set every repeat" name="text"/>
