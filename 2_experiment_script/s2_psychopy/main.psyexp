        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="$'Im Mittelpunkt der Studie steht eine Entscheidungsaufgabe:' + '\n' + 'Ihnen werden in mehreren Durchgängen Quadrate mit hellen und dunklen Flächen (sog. Fleckenbilder) gezeigt. Ihre Aufgabe ist es, zu beurteilen, welche Fläche insgesamt größer ist.' + '\n\n' + 'Wenn die Fläche ' + adjective[0] + ' Flecken insgesamt größer ist, drücken Sie bitte die Taste &quot;A&quot; für die Antwort &quot;' + condition[0] + '&quot;.' + &quot;\n&quot; + 'Wenn die Fläche ' + adjective[1] + ' Flecken insgesamt größer ist, drücken Sie bitte die Taste &quot;L&quot; für die Antwort &quot;' + condition[1] + '&quot;.' + '\n\n' + 'Für die Hälfte aller Fleckenbilder ist &quot;' + condition[0] + '&quot; die korrekte Antwort, für die andere Hälfte ist &quot;' + condition[1] + '&quot; die korrekte Antwort.' + &quot;\n\n&quot; + 'Vor der Präsentation jedes Fleckenbilds erscheint ein Kreuz in der Mitte des Bildschirms. Bitte richten Sie in jedem Durchgang Ihren Blick auf das Kreuz, bis das Fleckenbild erscheint.'&amp;#10;&amp;#10;" valType="str" updates="set every repeat" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
