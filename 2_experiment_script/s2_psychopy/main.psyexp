        <Param val="var acc_responses = 0&amp;#10;var delayed_responses = 0&amp;#10;var in_time_responses = 0&amp;#10;&amp;#10;var condition_met_acc = 0&amp;#10;var condition_met_fullscreen = 0&amp;#10;var condition_met = 0&amp;#10;&amp;#10;var fully_screenys = 0" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
